rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member() {
      return request.auth != null && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }
    function role() {
      return !member() ? '' : request.auth.token.get('adminRole',
        request.auth.token.get('admin', false) == true ? 'super_admin' :
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ?
          firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('role', '') : ''));
    }
    function root() { return role() == 'super_admin'; }
    function reviewer() { return role() in ['super_admin','kyc_reviewer']; }
    function ownedUpload(uid, category) {
      return member() && request.auth.uid == uid &&
        request.resource.metadata.ownerUid == uid &&
        request.resource.metadata.category == category &&
        request.resource.size > 0;
    }
    function image() { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }

    // Object identity is category/authenticated UID/random filename, never post ID.
    match /{category}/{uid}/{filename} {
      allow read: if category == 'posts';
      allow create: if category == 'posts' &&
        ownedUpload(uid,category) && image() && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if category == 'posts' && (member() && request.auth.uid == uid || root());
      // Updates/overwrites denied, including owner metadata reassignment.
    }
    function mediaFilename(filename) {
      return filename.matches('[a-zA-Z0-9_-]+[.](jpg|jpeg|png|webp)') &&
        ((request.resource.contentType == 'image/jpeg' && filename.matches('.*[.](jpg|jpeg)')) ||
         (request.resource.contentType == 'image/png' && filename.matches('.*[.]png')) ||
         (request.resource.contentType == 'image/webp' && filename.matches('.*[.]webp')));
    }
    function mediaModerator() { return role() in ['super_admin','moderation_admin']; }
    function eventCreator() { return role() in ['super_admin','moderation_admin','content_admin']; }
    match /avatars/{uid}/{filename} {
      allow read: if (member() && request.auth.uid == uid) || mediaModerator() ||
        (firestore.get(/databases/(default)/documents/users/$(uid)).data.photoModerationStatus == 'ACTIVE' &&
         firestore.get(/databases/(default)/documents/users/$(uid)).data.photoVisibilityStatus == 'PUBLIC' &&
         firestore.get(/databases/(default)/documents/users/$(uid)).data.photoPath == 'avatars/' + uid + '/' + filename);
      allow create: if ownedUpload(uid,'avatars') && image() && mediaFilename(filename) && request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.metadata.contentId == uid && firestore.get(/databases/(default)/documents/users/$(uid)).data.get('photoModerationStatus','ACTIVE') == 'ACTIVE';
      allow delete: if (member() && request.auth.uid == uid) || mediaModerator();
    }
    match /stories/{uid}/{filename} {
      allow read: if (member() && request.auth.uid == uid) || mediaModerator() ||
        (firestore.get(/databases/(default)/documents/stories/$(resource.metadata.contentId)).data.moderationStatus == 'ACTIVE' &&
         firestore.get(/databases/(default)/documents/stories/$(resource.metadata.contentId)).data.visibilityStatus == 'PUBLIC' &&
         firestore.get(/databases/(default)/documents/stories/$(resource.metadata.contentId)).data.mediaPath == 'stories/' + uid + '/' + filename &&
         firestore.get(/databases/(default)/documents/stories/$(resource.metadata.contentId)).data.expiresAt > request.time);
      allow create: if ownedUpload(uid,'stories') && image() && mediaFilename(filename) && request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.metadata.contentId.matches('[a-zA-Z0-9_-]+') &&
        !firestore.exists(/databases/(default)/documents/stories/$(request.resource.metadata.contentId));
      allow delete: if (member() && request.auth.uid == uid) || mediaModerator();
    }
    match /events/{uid}/{filename} {
      allow read: if (member() && request.auth.uid == uid) || mediaModerator() ||
        (firestore.get(/databases/(default)/documents/events/$(resource.metadata.contentId)).data.mediaModerationStatus == 'ACTIVE' &&
         firestore.get(/databases/(default)/documents/events/$(resource.metadata.contentId)).data.mediaVisibilityStatus == 'PUBLIC' &&
         firestore.get(/databases/(default)/documents/events/$(resource.metadata.contentId)).data.imagePath == 'events/' + uid + '/' + filename);
      allow create: if eventCreator() && ownedUpload(uid,'events') && image() && mediaFilename(filename) && request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.metadata.contentId.matches('[a-zA-Z0-9_-]+') &&
        (!firestore.exists(/databases/(default)/documents/events/$(request.resource.metadata.contentId)) ||
          (firestore.get(/databases/(default)/documents/events/$(request.resource.metadata.contentId)).data.get('imageOwnerId',uid) == uid &&
           firestore.get(/databases/(default)/documents/events/$(request.resource.metadata.contentId)).data.get('mediaModerationStatus','ACTIVE') == 'ACTIVE'));
      allow delete: if (member() && request.auth.uid == uid) || mediaModerator();
    }
    match /kyc/{uid}/{filename} {
      allow read: if reviewer();
      allow create: if ownedUpload(uid,'kyc') && request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg','image/png','application/pdf'];
      allow delete: if root();
    }
    match /private/{uid}/{filename} {
      allow read: if member() && request.auth.uid == uid;
      allow delete: if member() && request.auth.uid == uid;
    }
    // Existing public catalog files remain readable, with no new ownerless writes.
    match /public/{path=**} { allow read: if true; }
    match /activities/{id}/{filename} { allow read: if true; }
    match /verification/{id}/{filename} { allow read: if reviewer(); }
    match /admin/{path=**} { allow read: if root(); }
  }
}
