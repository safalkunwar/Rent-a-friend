rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member() { return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'; }
    function own(uid) { return member() && request.auth.uid == uid; }
    function role() {
      return !member() ? '' :
        request.auth.token.get('adminRole',
          request.auth.token.get('admin', false) == true ? 'super_admin' :
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') : ''));
    }
    function root() { return role() == 'super_admin'; }
    function hasRole(roles) { let current = role(); return current == 'super_admin' || current in roles; }
    function kyc() { return hasRole(['kyc_reviewer']); }
    function content() { return hasRole(['content_admin', 'moderation_admin']); }
    function support() { return hasRole(['support_agent', 'platform_admin']); }
    function bookingAdmin() { return hasRole(['booking_admin']); }
    function finance() { return hasRole(['finance_admin']); }
    function safety() { return hasRole(['safety_admin']); }
    function staffRead() { return hasRole(['platform_admin', 'support_agent', 'kyc_reviewer', 'booking_admin', 'safety_admin']); }
    function validRole(value) { return value in ['super_admin','platform_admin','safety_admin','moderation_admin','support_agent','booking_admin','finance_admin','kyc_reviewer','content_admin','analytics_admin','read_only_admin']; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function publicPost(id) {
      return get(/databases/$(database)/documents/community_posts/$(id)).data.status == 'published';
    }
    function conversationMember(id) {
      return member() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantIds;
    }
    function textValid(value) { return value is string && value.size() > 0 && value.size() <= 10000; }
    function counter(value) { return value is int && value >= 0; }
    function privateKycReference(data, uid) {
      let parts = data.get('documentFileUrl', '').split('/');
      return parts.size() == 3 && parts[0] == 'kyc' && parts[1] == uid && parts[2].size() > 0;
    }
    function likeDelta(collectionName, targetId, before, after) {
      let likePath = /databases/$(database)/documents/$(collectionName)/$(request.auth.uid + '_' + targetId);
      return counter(before) && counter(after) &&
        ((!exists(likePath) && existsAfter(likePath) && after == before + 1) ||
         (exists(likePath) && !existsAfter(likePath) && after == before - 1));
    }
    function commentDelta(postId) {
      let id = request.resource.data.get('lastCommentMutationId', '');
      let path = /databases/$(database)/documents/comments/$(id);
      let before = resource.data.get('commentsCount', 0);
      let after = request.resource.data.commentsCount;
      return member() && changedOnly(['commentsCount','lastCommentMutationId','updatedAt']) &&
        counter(before) && counter(after) &&
        ((!exists(path) && existsAfter(path) && getAfter(path).data.userId == request.auth.uid &&
          getAfter(path).data.postId == postId && after == before + 1) ||
         (exists(path) && !existsAfter(path) && (get(path).data.userId == request.auth.uid || content()) &&
          get(path).data.postId == postId && after == before - 1));
    }
    function pairedComment(postId, commentId, delta) {
      let path = /databases/$(database)/documents/community_posts/$(postId);
      return getAfter(path).data.lastCommentMutationId == commentId &&
        getAfter(path).data.commentsCount == get(path).data.get('commentsCount', 0) + delta;
    }

    // Public media policy: publish first; only protected moderators may restrict/restore.
    function mediaModerator() { return hasRole(['moderation_admin']); }
    function mediaStatus(status) { return status in ['ACTIVE','UNDER_REVIEW','RESTRICTED','REMOVED']; }
    function mediaReference(path, url, category, uid) {
      let parts = path.split('/');
      return parts.size() == 3 && parts[0] == category && parts[1] == uid &&
        parts[2].matches('[a-zA-Z0-9_-]+[.](jpg|jpeg|png|webp)') &&
        url is string && url.size() <= 2000 &&
        // Project buckets only; loopback is the local emulator transport, not an authorization bypass.
        url.matches('(https://firebasestorage[.]googleapis[.]com|http://127[.]0[.]0[.]1:9195)/v0/b/hamrosathi1[.](firebasestorage[.]app|appspot[.]com)/o/' +
          category + '%2F' + uid + '%2F' + parts[2].replace('[.]','[.]') + '[?]alt=media.*');
    }
    function profilePhotoWrite(uid) {
      let data = request.resource.data;
      return own(uid) && resource.data.get('photoModerationStatus','ACTIVE') == 'ACTIVE' &&
        changedOnly(['avatar','photoPath','photoUpdatedAt','photoModerationStatus','photoVisibilityStatus','photoReportedCount']) &&
        data.photoModerationStatus == 'ACTIVE' && data.photoVisibilityStatus == 'PUBLIC' &&
        data.photoReportedCount == resource.data.get('photoReportedCount',0) &&
        mediaReference(data.photoPath,data.avatar,'avatars',uid);
    }

    match /users/{uid} {
      allow read: if own(uid) || staffRead();
      allow create: if own(uid) && request.resource.data.keys().hasOnly([
        'id','name','email','avatar','role','favorites','createdAt','updatedAt'
      ]) && request.resource.data.get('id', uid) == uid && request.resource.data.role == 'customer';
      allow update: if (own(uid) && changedOnly([
        'name','preferences','updatedAt','favorites','fcmToken','phone','bio',
        'languages','skills','availability','interests','location'
      ])) || (root() && changedOnly(['name','phone','bio','location','role','status','companionStatus','updatedAt'])) ||
        (kyc() && !own(uid) && changedOnly(['companionStatus','updatedAt'])) || profilePhotoWrite(uid) ||
        (mediaModerator() && changedOnly(['photoModerationStatus','photoVisibilityStatus','photoModeratedAt','photoModeratedBy','photoModerationReason','photoReportedCount']) &&
          mediaStatus(request.resource.data.photoModerationStatus) && request.resource.data.photoModeratedBy == request.auth.uid &&
          request.resource.data.photoVisibilityStatus in ['PUBLIC','PRIVATE'] && request.resource.data.photoReportedCount >= 0);
      allow delete: if root();
      match /favorites/{id} {
        allow read, create, update, delete: if own(uid) || root();
      }
    }
    match /admins/{uid} {
      allow read: if own(uid) || root();
      allow create, update: if root() && validRole(request.resource.data.role);
      allow delete: if root();
    }
    match /companions/{id} {
      allow read: if true;
      allow create: if kyc() && request.resource.data.userId != request.auth.uid &&
        request.resource.data.keys().hasOnly(['id','userId','name','bio','categories','interests','languages','location',
          'hourlyRate','imageUrl','rating','reviewsCount','isVerified','verificationBadge','availability','createdAt','updatedAt','age','gender','availableDays']) &&
        request.resource.data.userId == id && request.resource.data.get('rating',0) == 0 &&
        request.resource.data.get('reviewsCount',0) == 0;
      allow update: if (own(resource.data.userId) && changedOnly([
        'name','bio','location','hourlyRate','gender','languages','interests','images',
        'imageUrl','availableDays','updatedAt'
      ])) || (kyc() && !own(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        changedOnly(['name','bio','categories','interests','languages','location','hourlyRate','imageUrl',
          'isVerified','verificationBadge','availability','updatedAt','createdAt','id']));
      allow delete: if root();
    }
    match /companion_applications/{id} {
      allow read: if own(resource.data.userId) || kyc();
      allow create: if own(request.resource.data.userId) &&
        request.resource.data.keys().hasOnly(['id','userId','status','applicationData','kyc','submittedAt','createdAt','updatedAt']) &&
        request.resource.data.status in ['DRAFT','SUBMITTED'] && request.resource.data.kyc.verificationStatus == 'UNVERIFIED';
      allow update: if (own(resource.data.userId) &&
        resource.data.status in ['DRAFT','CHANGES_REQUIRED'] &&
        request.resource.data.status in ['DRAFT','SUBMITTED','CHANGES_REQUIRED'] &&
        (request.resource.data.status != 'SUBMITTED' || privateKycReference(request.resource.data.kyc,request.auth.uid)) &&
        request.resource.data.kyc.verificationStatus == 'UNVERIFIED' &&
        changedOnly(['applicationData','kyc','status','submittedAt','updatedAt'])) ||
        (kyc() && !own(resource.data.userId) && resource.data.status in ['SUBMITTED','UNDER_REVIEW'] &&
         request.resource.data.status in ['UNDER_REVIEW','APPROVED','REJECTED','CHANGES_REQUIRED'] &&
         request.resource.data.reviewedBy == request.auth.uid &&
         changedOnly(['status','kyc','reviewedBy','reviewedAt','updatedAt','rejectionReason','requestedChanges']));
      allow delete: if root();
    }

    function lockKey(data) { return 'lock_' + data.companionId + '_' + data.date.replace('[^a-zA-Z0-9]', '_'); }
    function bookingTime(data) {
      return timestamp.date(int(data.date[0:4]),int(data.date[5:7]),int(data.date[8:10])) +
        duration.value(int(data.time[0:2]) * 60 + int(data.time[3:5]) - 345,'m');
    }
    function pairedLock(data,id) {
      let lock = getAfter(/databases/$(database)/documents/booking_locks/$(lockKey(data))).data;
      return lock.bookingId == id && lock.companionId == data.companionId && lock.date == data.date && lock.status == data.status;
    }
    function availableLock(data) {
      let path = /databases/$(database)/documents/booking_locks/$(lockKey(data));
      return !exists(path) || (get(path).data.status == 'cancelled' &&
        get(/databases/$(database)/documents/bookings/$(get(path).data.bookingId)).data.status == 'cancelled');
    }
    // BEGIN GENERATED BOOKING TRANSITIONS
    function policyTransition(data, next) {
      return (data.status == 'pending' && next == 'confirmed' && (own(data.companionUid) || bookingAdmin())) ||
        (data.status == 'pending' && next == 'cancelled' && (own(data.userId) || own(data.companionUid) || bookingAdmin())) ||
        (data.status == 'confirmed' && next == 'active' && (own(data.companionUid) || bookingAdmin())) ||
        (data.status == 'confirmed' && next == 'cancelled' && (own(data.userId) || own(data.companionUid) || bookingAdmin())) ||
        (data.status == 'active' && next == 'completed' && (own(data.companionUid) || bookingAdmin())) ||
        (data.status == 'active' && next == 'cancelled' && (bookingAdmin()));
    }
    // END GENERATED BOOKING TRANSITIONS
    function validReservation(data,id) {
      let companion = get(/databases/$(database)/documents/companions/$(data.companionId)).data;
      return own(data.userId) && data.id == id && data.policyVersion == 2 &&
        data.companionId == data.companionUid && data.companionUid == companion.userId && data.companionUid != request.auth.uid &&
        companion.isVerified == true &&
        get(/databases/$(database)/documents/users/$(data.companionUid)).data.companionStatus == 'APPROVED' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status','ACTIVE') == 'ACTIVE' &&
        data.status == 'pending' && data.paymentStatus == 'not_started' &&
        data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]') &&
        data.duration is int && data.duration >= 1 && data.duration <= 12 &&
        data.participants is int && data.participants >= 1 && data.participants <= 8 &&
        int(data.time[0:2])*60 + int(data.time[3:5]) + data.duration*60 <= 1440 &&
        data.startAt == bookingTime(data) && data.startAt > request.time &&
        companion.hourlyRate is int && companion.hourlyRate >= 500 &&
        data.quotedTotalPaisa == companion.hourlyRate * data.duration * (110 + 33 * (data.participants - 1)) &&
        data.totalPrice == data.quotedTotalPaisa / 100 &&
        textValid(data.meetingPoint) && textValid(data.userNameAtBooking) && textValid(data.userPhoneAtBooking) &&
        data.keys().hasOnly(['id','userId','companionId','companionUid','date','time','duration','participants','meetingPoint',
          'meetingCoordinates','specialRequests','userNameAtBooking','userPhoneAtBooking','userEmailAtBooking','status',
          'paymentStatus','policyVersion','totalPrice','quotedTotalPaisa','startAt','createdAt','updatedAt']) &&
        availableLock(data) && pairedLock(data,id);
    }
    match /bookings/{id} {
      allow get: if member() && !exists(/databases/$(database)/documents/bookings/$(id));
      allow read: if own(resource.data.userId) || own(resource.data.get('companionUid', resource.data.companionId)) || bookingAdmin();
      allow create: if validReservation(request.resource.data,id);
      allow update: if resource.data.policyVersion == 2 && changedOnly(['status','updatedAt']) &&
        policyTransition(resource.data,request.resource.data.status) &&
        (request.resource.data.status != 'active' || request.time >= resource.data.startAt) &&
        (request.resource.data.status != 'completed' || request.time >= resource.data.startAt + duration.value(resource.data.duration,'h')) &&
        get(/databases/$(database)/documents/booking_locks/$(lockKey(resource.data))).data.bookingId == id &&
        pairedLock(request.resource.data,id);
    }
    match /booking_locks/{id} {
      allow read: if member();
      function matchingBooking() {
        let data = request.resource.data;
        let book = getAfter(/databases/$(database)/documents/bookings/$(data.bookingId)).data;
        return data.keys().hasOnly(['bookingId','companionId','date','status','updatedAt']) && id == lockKey(book) &&
          data.companionId == book.companionId && data.date == book.date && data.status == book.status;
      }
      function newReservation() {
        let path = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);
        return !exists(path) && own(getAfter(path).data.userId) && request.resource.data.status == 'pending';
      }
      allow create: if matchingBooking() && newReservation();
      allow update: if matchingBooking() &&
        ((newReservation() && resource.data.status == 'cancelled' &&
          get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == 'cancelled') ||
         (request.resource.data.bookingId == resource.data.bookingId && changedOnly(['status','updatedAt']) &&
          getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status !=
          get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status));
    }
    match /payments/{id} {
      allow read: if own(resource.data.userId) || finance();
      allow write: if false; // Only a future trusted provider-verification backend may write.
    }
    match /reviews/{id} {
      allow read: if true;
      allow write: if false; // No client-controlled rating aggregates/commercial claims.
    }

    match /community_posts/{id} {
      allow read: if resource.data.status == 'published' || own(resource.data.userId) || content();
      allow create: if own(request.resource.data.userId) && request.resource.data.status in ['draft','published'] &&
        request.resource.data.get('likesCount',0) == 0 && request.resource.data.get('commentsCount',0) == 0 &&
        !request.resource.data.keys().hasAny(['reviewedBy','moderationStatus','isVerified']);
      allow update: if (own(resource.data.userId) && resource.data.status in ['draft','published'] &&
        request.resource.data.status in ['draft','published'] &&
        changedOnly(['title','content','category','tags','imageURL','status','updatedAt'])) ||
        (content() && changedOnly(['status','updatedAt'])) ||
        (member() && publicPost(id) && changedOnly(['likesCount','updatedAt']) &&
         likeDelta('likes',id,resource.data.get('likesCount',0),request.resource.data.likesCount)) ||
        commentDelta(id);
      allow delete: if own(resource.data.userId) || content();
    }
    match /comments/{id} {
      allow read: if publicPost(resource.data.postId) || own(resource.data.userId) || content();
      allow create: if own(request.resource.data.userId) && publicPost(request.resource.data.postId) &&
        request.resource.data.id == id && request.resource.data.createdAt is timestamp &&
        request.resource.data.createdAt == request.time &&
        textValid(request.resource.data.text) && request.resource.data.text.size() <= 500 &&
        request.resource.data.keys().hasOnly(['id','postId','userId','userName','userAvatar','text','createdAt','parentId']) &&
        pairedComment(request.resource.data.postId,id,1);
      allow update: if own(resource.data.userId) && changedOnly(['text']) && textValid(request.resource.data.text) && request.resource.data.text.size() <= 500;
      allow delete: if (own(resource.data.userId) || content()) &&
        pairedComment(resource.data.postId,id,-1);
    }
    match /likes/{id} {
      allow read: if true;
      allow create: if own(request.resource.data.userId) && id == request.auth.uid + '_' + request.resource.data.postId &&
        request.resource.data.keys().hasOnly(['userId','postId','createdAt']) && publicPost(request.resource.data.postId) &&
        getAfter(/databases/$(database)/documents/community_posts/$(request.resource.data.postId)).data.likesCount ==
        get(/databases/$(database)/documents/community_posts/$(request.resource.data.postId)).data.get('likesCount',0) + 1;
      allow delete: if own(resource.data.userId) && id == request.auth.uid + '_' + resource.data.postId &&
        getAfter(/databases/$(database)/documents/community_posts/$(resource.data.postId)).data.likesCount ==
        get(/databases/$(database)/documents/community_posts/$(resource.data.postId)).data.get('likesCount',0) - 1;
    }
    match /stories/{id} {
      allow get: if member() && !exists(/databases/$(database)/documents/stories/$(id));
      allow read: if (resource.data.moderationStatus == 'ACTIVE' && resource.data.visibilityStatus == 'PUBLIC' && resource.data.status == 'active') || own(resource.data.userId) || mediaModerator();
      allow create: if own(request.resource.data.userId) &&
        request.resource.data.id == id && request.resource.data.contentType == 'story' && request.resource.data.mediaType == 'image' &&
        request.resource.data.moderationStatus == 'ACTIVE' && request.resource.data.visibilityStatus == 'PUBLIC' && request.resource.data.status == 'publishing' &&
        request.resource.data.reportedCount == 0 && request.resource.data.caption is string && request.resource.data.caption.size() <= 150 &&
        request.resource.data.createdAt == request.time && request.resource.data.expiresAt == null &&
        mediaReference(request.resource.data.mediaPath,request.resource.data.imageUrl,'stories',request.auth.uid) &&
        request.resource.data.keys().hasOnly(['id','userId','contentType','mediaType','userName','userAvatar','companionName','caption','timeAgo',
          'imageUrl','mediaPath','createdAt','updatedAt','expiresAt','status','moderationStatus','visibilityStatus','reportedCount','likes','likesCount','comments','commentsCount']) &&
        request.resource.data.get('likes',0) == 0 && request.resource.data.get('likesCount',0) == 0 &&
        request.resource.data.get('comments',0) == 0 && request.resource.data.get('commentsCount',0) == 0;
      allow update: if (own(resource.data.userId) && resource.data.moderationStatus == 'ACTIVE' && changedOnly(['caption','updatedAt']) && request.resource.data.caption.size() <= 150) ||
        (own(resource.data.userId) && resource.data.moderationStatus == 'ACTIVE' && resource.data.visibilityStatus == 'PUBLIC' &&
          resource.data.status == 'publishing' && request.resource.data.status == 'active' && changedOnly(['status','expiresAt']) &&
          request.resource.data.expiresAt == resource.data.createdAt + duration.value(24,'h')) ||
        (mediaModerator() && changedOnly(['moderationStatus','visibilityStatus','moderationReason','moderatedAt','moderatedBy','reportedCount']) &&
          mediaStatus(request.resource.data.moderationStatus) && request.resource.data.moderatedBy == request.auth.uid &&
          request.resource.data.visibilityStatus in ['PUBLIC','PRIVATE'] && request.resource.data.reportedCount >= 0) ||
        (member() && changedOnly(['likes','likesCount','updatedAt']) &&
         request.resource.data.likes == request.resource.data.likesCount &&
         likeDelta('story_likes',id,resource.data.get('likesCount',resource.data.get('likes',0)),request.resource.data.likesCount));
      allow delete: if own(resource.data.userId) || content();
}
    match /story_likes/{id} {
      allow read: if true;
      allow create: if own(request.resource.data.userId) && id == request.auth.uid + '_' + request.resource.data.storyId &&
        request.resource.data.keys().hasOnly(['userId','storyId','createdAt']) &&
        getAfter(/databases/$(database)/documents/stories/$(request.resource.data.storyId)).data.likesCount ==
        getAfter(/databases/$(database)/documents/stories/$(request.resource.data.storyId)).data.get('likesCount',0) + 1;
      allow delete: if own(resource.data.userId) && id == request.auth.uid + '_' + resource.data.storyId &&
        getAfter(/databases/$(database)/documents/stories/$(request.resource.data.storyId)).data.likesCount ==
        getAfter(/databases/$(database)/documents/stories/$(request.resource.data.storyId)).data.get('likesCount',0) - 1;
    }
    match /comments/{id} {
      // Comments on community posts - read by anyone on published posts
      allow read: if get(/databases/$(database)/documents/community_posts/$(resource.data.postId)).data.status == 'published';
      // Create comment on published post - atomic counter via pairedComment
      allow create: if own(request.resource.data.userId) &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasOnly(['id','postId','userId','userName','userAvatar','text','createdAt','parentId']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 &&
        get(/databases/$(database)/documents/community_posts/$(request.resource.data.postId)).data.status == 'published' &&
        pairedComment(request.resource.data.postId, id, 1);
      // User can edit own comment
      allow update: if own(resource.data.userId) &&
        changedOnly(['text','updatedAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      // User can delete own comment, content moderators can delete any
      allow delete: if own(resource.data.userId) || content();
    }
    match /conversations/{id} {
      allow get: if member() && !exists(/databases/$(database)/documents/conversations/$(id));
      allow read: if (member() && request.auth.uid in resource.data.participantIds) || content();
      allow create: if member() && request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds[0] != request.resource.data.participantIds[1] &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.keys().hasOnly(['id','participantIds','unreadCount','lastMessage','createdAt','updatedAt']);
      allow update: if conversationMember(id) && changedOnly(['lastMessage','unreadCount','updatedAt']);
      allow delete: if root();
      match /typing/{uid} {
        allow read: if conversationMember(id);
        allow write: if own(uid) && conversationMember(id);
      }
    }
    match /messages/{id} {
      allow read: if conversationMember(resource.data.conversationId) || content();
      allow create: if own(request.resource.data.senderId) && conversationMember(request.resource.data.conversationId) &&
        request.resource.data.isRead == false && textValid(request.resource.data.text) &&
        request.resource.data.keys().hasOnly(['id','conversationId','senderId','text','timestamp','isRead','status','updatedAt']);
      allow update: if conversationMember(resource.data.conversationId) &&
        !own(resource.data.senderId) && changedOnly(['isRead','updatedAt']) && request.resource.data.isRead == true;
      allow delete: if content();
    }
    match /notifications/{id} {
      allow read: if own(resource.data.userId) || support();
      allow create: if own(request.resource.data.userId) && request.resource.data.isRead == false;
      allow update: if own(resource.data.userId) && changedOnly(['isRead']);
      allow delete: if own(resource.data.userId) || root();
    }

    match /events/{id} {
      allow read: if true;
      function mediaFields() { return ['imageUrl','image','imagePath','imageOwnerId','mediaModerationStatus','mediaVisibilityStatus','imageUpdatedAt',
        'mediaReportedCount','mediaModeratedAt','mediaModeratedBy','mediaModerationReason']; }
      function validEventMedia() {
        let data = request.resource.data;
        return data.imageOwnerId == request.auth.uid && data.mediaModerationStatus == 'ACTIVE' && data.mediaVisibilityStatus == 'PUBLIC' &&
          mediaReference(data.imagePath,data.imageUrl,'events',request.auth.uid);
      }
      allow create: if content() && ((!request.resource.data.keys().hasAny(mediaFields())) ||
        (validEventMedia() && request.resource.data.mediaReportedCount == 0 &&
         !request.resource.data.keys().hasAny(['mediaModeratedAt','mediaModeratedBy','mediaModerationReason','image'])));
      allow update: if (content() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(mediaFields())) ||
        (content() && resource.data.get('imageOwnerId',request.auth.uid) == request.auth.uid && resource.data.get('mediaModerationStatus','ACTIVE') == 'ACTIVE' &&
          validEventMedia() && request.resource.data.mediaReportedCount == resource.data.get('mediaReportedCount',0) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mediaModeratedAt','mediaModeratedBy','mediaModerationReason','image'])) ||
        (mediaModerator() && changedOnly(['mediaModerationStatus','mediaVisibilityStatus','mediaModeratedAt','mediaModeratedBy','mediaModerationReason','mediaReportedCount']) &&
          mediaStatus(request.resource.data.mediaModerationStatus) && request.resource.data.mediaModeratedBy == request.auth.uid &&
          request.resource.data.mediaVisibilityStatus in ['PUBLIC','PRIVATE'] && request.resource.data.mediaReportedCount >= 0);
      allow delete: if content();
      match /participants/{uid} {
        allow read: if own(uid) || bookingAdmin();
        allow update: if own(uid) && changedOnly(['status','updatedAt']) && request.resource.data.status == 'cancelled';
        allow delete: if own(uid) || bookingAdmin();
      }
    }
    match /event_participants/{id} {
      allow read: if own(resource.data.userId) || bookingAdmin();
      allow create: if false; // Atomic capacity contract deferred; no unsafe joining.
      allow update: if own(resource.data.userId) && changedOnly(['status','updatedAt']) && request.resource.data.status == 'cancelled';
      allow delete: if own(resource.data.userId) || bookingAdmin();
    }
    match /activities/{id} {
      allow read: if true;
      allow create: if content();
      allow update: if content() || (own(resource.data.companionId) &&
        changedOnly(['title','description','imageUrl','updatedAt']));
      allow delete: if content();
    }
    match /{catalog}/{id} {
      allow read: if catalog in ['partners','hotels','restaurants','cafes','cities'];
      allow write: if catalog in ['partners','hotels','restaurants','cafes','cities'] && content();
    }
    match /reports/{id} {
      allow read: if own(resource.data.reporterId) || content() || safety();
      allow create: if own(request.resource.data.reporterId) && request.resource.data.status == 'open';
      allow update: if (content() || safety()) && changedOnly(['status','adminNotes','updatedAt']);
      allow delete: if root();
    }
    match /support_tickets/{id} {
      allow read: if own(resource.data.userId) || support();
      allow create: if own(request.resource.data.userId) && request.resource.data.status == 'open' &&
        !request.resource.data.keys().hasAny(['assignedTo','adminNotes','response']);
      allow update: if (own(resource.data.userId) && changedOnly(['subject','message','updatedAt'])) ||
        (support() && changedOnly(['status','assignedTo','adminNotes','response','updatedAt']));
      allow delete: if root();
    }
    match /feedback/{id} {
      allow read: if own(resource.data.userId) || support();
      allow create: if own(request.resource.data.userId) && request.resource.data.status == 'new';
      allow update: if support() && changedOnly(['status','adminNotes','updatedAt']);
      allow delete: if root();
    }
    match /sosAlerts/{id} {
      allow read: if own(resource.data.userId) || safety();
      allow create: if own(request.resource.data.userId) && request.resource.data.status == 'active';
      allow update: if (own(resource.data.userId) && changedOnly(['status','updatedAt']) &&
        request.resource.data.status == 'cancelled') ||
        (safety() && changedOnly(['status','adminNotes','updatedAt']));
    }
    match /auditLogs/{id} {
      allow read: if staffRead() || content() || finance() || safety();
      allow create: if member() && request.resource.data.actorId == request.auth.uid;
    }
    match /admin_audit_logs/{id} {
      allow read: if kyc();
      allow create: if kyc() && request.resource.data.actorId == request.auth.uid;
    }
    match /presence/{uid} { allow read, write: if own(uid); }
    match /guideApplications/{id} { allow read: if own(resource.data.userId) || kyc(); }
    match /verification_requests/{id} { allow read: if own(resource.data.companionId) || kyc(); }
    match /booking_locations/{id} {
      allow read: if own(resource.data.userId) || own(resource.data.companionId) || safety();
      match /locations/{locationId} { allow read: if safety(); }
    }
    match /booking_reminders/{id} { allow read: if own(resource.data.userId) || bookingAdmin(); }
    match /analytics/{id} { allow read: if hasRole(['analytics_admin']); }
    match /suspiciousActivity/{id} {
      allow read: if safety();
      allow create, update: if safety();
    }
  }
}
