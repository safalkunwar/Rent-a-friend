{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test:welcome-grant": "npm run build && node --test test/welcomeGrant.test.mjs",
    "test:coin-wallet-read": "npm run build && node --test test/coinWalletRead.test.mjs",
    "test:coin-emulator": "npm run build && firebase emulators:exec --config ../firebase.json --only firestore --project demo-sathi-coins \"node --test test/welcomeGrant.emulator.test.mjs test/profileUnlockGrant.emulator.test.mjs test/welcomeCoinIdentity.emulator.test.mjs\"",
    "test:welcome-identity-storage": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-sathi-identity \"node --test test/welcomeIdentity.storage.emulator.test.mjs\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0"
  },
  "private": true
}
